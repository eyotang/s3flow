{
  "name": "@eyotang/s3flow",
  "version": "0.8.0",
  "description": "Cross-platform S3 CLI for listing, transfers, extraction, and search",
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "repository": { "type": "git", "url": "git+https://github.com/eyotang/s3flow.git" },
  "engines": { "node": ">=18" },
  "bin": {
    "s3flow": "npm/cli.cjs",
    "s3get": "npm/s3get.cjs",
    "s3push": "npm/s3push.cjs",
    "s3unzip": "npm/s3unzip.cjs",
    "s3rg": "npm/s3rg.cjs",
    "s3tree": "npm/s3tree.cjs",
    "s3du": "npm/s3du.cjs",
    "s3sync": "npm/s3sync.cjs",
    "s3cp": "npm/s3cp.cjs",
    "s3mv": "npm/s3mv.cjs",
    "s3presign": "npm/s3presign.cjs"
  },
  "files": ["npm/*.cjs", "npm/native/", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test npm/test/*.test.cjs",
    "test:package": "node scripts/test-npm-package.cjs"
  }
}
